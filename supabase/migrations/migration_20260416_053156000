-- 1. Update default credits to 500 in trigger
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER AS $$
BEGIN
  INSERT INTO public.profiles (id, email, display_name, role, credits)
  VALUES (
    NEW.id,
    NEW.email,
    COALESCE(NEW.raw_user_meta_data->>'display_name', split_part(NEW.email, '@', 1)),
    'user',
    500
  );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 2. Update all existing ai_models cost to 100
UPDATE public.ai_models SET cost_per_analysis = 100;
ALTER TABLE public.ai_models ALTER COLUMN cost_per_analysis SET DEFAULT 100;

-- 3. Referral codes table
CREATE TABLE IF NOT EXISTS public.referral_codes (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  code TEXT NOT NULL UNIQUE,
  referrer_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  used_count INTEGER NOT NULL DEFAULT 0,
  total_credits_earned INTEGER NOT NULL DEFAULT 0,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- 4. Referral usages table (track which new users used which code)
CREATE TABLE IF NOT EXISTS public.referral_usages (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  referral_code_id UUID NOT NULL REFERENCES public.referral_codes(id) ON DELETE CASCADE,
  new_user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  credits_granted INTEGER NOT NULL DEFAULT 300,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE(new_user_id) -- each user can only use one referral code
);

-- RLS
ALTER TABLE public.referral_codes ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.referral_usages ENABLE ROW LEVEL SECURITY;

CREATE POLICY "referral_codes_select_own" ON public.referral_codes
  FOR SELECT USING (auth.uid() = referrer_id);

CREATE POLICY "referral_codes_insert_own" ON public.referral_codes
  FOR INSERT WITH CHECK (auth.uid() = referrer_id);

CREATE POLICY "referral_usages_select_own" ON public.referral_usages
  FOR SELECT USING (
    auth.uid() = new_user_id OR
    EXISTS (SELECT 1 FROM public.referral_codes rc WHERE rc.id = referral_code_id AND rc.referrer_id = auth.uid())
  );

-- Indexes
CREATE INDEX IF NOT EXISTS idx_referral_codes_referrer ON public.referral_codes(referrer_id);
CREATE INDEX IF NOT EXISTS idx_referral_codes_code ON public.referral_codes(code);
CREATE UNIQUE INDEX IF NOT EXISTS idx_referral_usages_user ON public.referral_usages(new_user_id);